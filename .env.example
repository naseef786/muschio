# Muschio Environment Configuration

# Database (PostgreSQL on Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/muschio?schema=public"

# Redis (Upstash / Local)
REDIS_URL="redis://localhost:6379"

# API & Storefront URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:5173"

# JWT & Authentication
JWT_SECRET="super-secret-jwt-key-muschio-luxury-perfumery-2026"
ADMIN_JWT_SECRET="super-secret-admin-jwt-key-muschio-luxury-perfumery-2026"

# DeepSeek AI
DEEPSEEK_API_KEY="sk-mock-deepseek-key-replace-with-real"
DEEPSEEK_API_URL="https://api.deepseek.com/v1"

# Payment Gateways (Sandboxes)
TABBY_PUBLIC_KEY="pk_test_tabby_key"
TABBY_SECRET_KEY="sk_test_tabby_key"
TABBY_MERCHANT_CODE="muschio_ae"

TAMARA_API_KEY="tamara_test_api_key"
TAMARA_API_URL="https://api-sandbox.tamara.co"

STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret"

# Cloudflare R2 / S3 Media Storage
R2_ACCOUNT_ID="mock-account-id"
R2_ACCESS_KEY_ID="mock-access-key-id"
R2_SECRET_ACCESS_KEY="mock-secret-access-key"
R2_BUCKET_NAME="muschio-media"
R2_PUBLIC_DOMAIN="https://media.muschio.luxury"
# Delivery stays inactive until approved rates and service coverage are configured.
DELIVERY_ENABLED=false
DELIVERY_RULES_JSON=[]
